{
  "name": "german-tutor-ts",
  "version": "1.0.0",
  "description": "High-performance German voice tutor – TypeScript/Node.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "build:frontend": "cd frontend && npm run build",
    "setup": "npm install && cd frontend && npm install --prefer-offline"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.0.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "js-yaml": "^4.1.0",
    "playwright": "^1.60.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "groq-sdk": "^0.13.0",
    "openai": "^4.98.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "esbuild": "0.25.5"
  }
}
