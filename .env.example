# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000

# ── LLM ───────────────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | openai | groq | anthropic
LLM_MODEL=gemma4:e2b
LLM_CORRECTOR_MODEL=granite4.1:3b
OLLAMA_URL=http://localhost:11434/api/chat

# ── STT ───────────────────────────────────────────────────────────────────────
STT_PROVIDER=local           # local | groq | openai
STT_MODEL=large-v3-turbo     # tiny | base | small | medium | large-v3-turbo
STT_COMPUTE=int8
STT_PORT=5001

# Python binary for STT sidecar + Piper TTS.
# Defaults to .venv/bin/python — override only if using a different environment.
# PYTHON_BIN=.venv/bin/python

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_PROVIDER=piper           # piper | openai | edge | elevenlabs
PIPER_VOICE=./voices/de_DE-thorsten-medium.onnx

# ── Cloud API keys ─────────────────────────────────────────────────────────────
# Only needed when using the corresponding cloud provider.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=alloy

GROQ_API_KEY=
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3-turbo

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
